		usb@c9000000 {
			compatible = "amlogic,meson-gxbb-usb", "snps,dwc2";
			reg = <0x00 0xc9000000 0x00 0x40000>;
			interrupts = <0x00 0x1e 0x04>;
			clocks = <0x03 0x41>;
			clock-names = "otg";
			phys = <0x38>;
			phy-names = "usb2-phy";
			dr_mode = "host";
			status = "okay";
		};

		usb@c9100000 {
			compatible = "amlogic,meson-gxbb-usb", "snps,dwc2";
			reg = <0x00 0xc9100000 0x00 0x40000>;
			interrupts = <0x00 0x1f 0x04>;
			clocks = <0x03 0x40>;
			clock-names = "otg";
			phys = <0x39>;
			phy-names = "usb2-phy";
			dr_mode = "host";
			status = "okay";
		};
	};

	opp-table {
		compatible = "operating-points-v2";
		phandle = <0x30>;

		opp-125000000 {
			opp-hz = <0x00 0x7735940>;
			opp-microvolt = <0xe7ef0>;
		};

		opp-250000000 {
			opp-hz = <0x00 0xee6b280>;
			opp-microvolt = <0xe7ef0>;
		};

		opp-285714285 {
			opp-hz = <0x00 0x1107a76d>;
			opp-microvolt = <0xe7ef0>;
		};

		opp-400000000 {
			opp-hz = <0x00 0x17d78400>;
			opp-microvolt = <0xe7ef0>;
		};

		opp-500000000 {
			opp-hz = <0x00 0x1dcd6500>;
			opp-microvolt = <0xe7ef0>;
		};

		opp-666666666 {
			opp-hz = <0x00 0x27bc86aa>;
			opp-microvolt = <0xe7ef0>;
		};

		opp-744000000 {
			opp-hz = <0x00 0x2c588a00>;
			opp-microvolt = <0xe7ef0>;
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x40000000>;
	};

	regulator-usb-pwrs {
		compatible = "regulator-fixed";
		regulator-name = "USB_PWR";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0x23 0x45 0x00>;
		enable-active-high;
		phandle = <0x37>;
	};

	gpio-regulator {
		compatible = "regulator-gpio";
		regulator-name = "VDDIO_CARD";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x325aa0>;
		gpios = <0x3a 0x05 0x00>;
		gpios-states = <0x01>;
		states = <0x1b7740 0x00 0x325aa0 0x01>;
		regulator-settling-time-up-us = <0x2710>;
		regulator-settling-time-down-us = <0x249f0>;
		phandle = <0x2a>;
	};

	regulator-vddio-boot {
		compatible = "regulator-fixed";
		regulator-name = "VDDIO_BOOT";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		phandle = <0x27>;
	};

	regulator-vddao-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VDDAO_3V3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		phandle = <0x26>;
	};

	regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VCC_3V3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		phandle = <0x2f>;
	};

	emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <0x23 0x1d 0x01>;
		phandle = <0x2e>;
	};

	wifi32k {
		compatible = "pwm-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		pwms = <0x3b 0x00 0x7736 0x00>;
		status = "disabled";
		phandle = <0x3c>;
	};

	sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <0x23 0x62 0x01>;
		clocks = <0x3c>;
		clock-names = "ext_clock";
		status = "disabled";
	};

	cvbs-connector {
		compatible = "composite-video-connector";

		port {

			endpoint {
				remote-endpoint = <0x3d>;
				phandle = <0x31>;
			};
		};
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {

			endpoint {
				remote-endpoint = <0x3e>;
				phandle = <0x36>;
			};
		};
	};

	regulator-vcc-5v {
		compatible = "regulator-fixed";
		regulator-name = "VCC_5V";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-always-on;
		phandle = <0x3f>;
	};

	regulator-wifi-pwr {
		compatible = "regulator-fixed";
		regulator-name = "WIFI_PWR";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x23 0x62 0x00>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	audio-codec {
		compatible = "everest,es7154";
		status = "okay";
		#sound-dai-cells = <0x00>;
		VDD-supply = <0x3f>;
		PVDD-supply = <0x2f>;
		sound-name-prefix = "Lineout";
		phandle = <0x41>;
	};

	leds {
		compatible = "gpio-leds";

		led-status {
			label = "m13:status";
			gpios = <0x3a 0x0d 0x01>;
			default-state = "off";
			linux,default-trigger = "heartbeat";
		};
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <0x64>;

		power-button {
			label = "Power";
			linux,code = <0x74>;
			gpios = <0x3a 0x03 0x01>;
		};
	};

	sound {
		compatible = "amlogic,gx-sound-card";
		status = "okay";
		model = "Tianmao-M13";
		clocks = <0x03 0x0d 0x03 0x0e 0x03 0x0f>;
		assigned-clocks = <0x03 0x0d 0x03 0x0e 0x03 0x0f>;
		assigned-clock-rates = <0x11940000 0x10266000 0x17700000>;

		dai-link-0 {
			sound-dai = <0x40 0x00 0x00>;
		};

		dai-link-1 {
			sound-dai = <0x40 0x00 0x02>;
			dai-format = "i2s";
			mclk-fs = <0x100>;

			codec-0 {
				sound-dai = <0x40 0x01 0x00>;
			};

			codec-1 {
				sound-dai = <0x41>;
			};
		};

		dai-link-2 {
			sound-dai = <0x40 0x01 0x02>;

			codec-0 {
				sound-dai = <0x1a>;
			};
		};
	};
};
